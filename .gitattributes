# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts
*.sh text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary

# Gradle wrapper - keep LF
gradle/wrapper/gradle-wrapper.properties text eol=lf
gradlew text eol=lf
